// Copy to oath-relay.jsonc, fill in your tokens, chmod 600.
{
  "server": { "host": "127.0.0.1", "port": 8790, "allow_peek": false },
  "state": { "path": "./state/state.json" },

  "auth": {
    // Generate the hash with: oath-relay hash
    "basic_user": "",
    "basic_password_hash": "",
    // Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
    "bearer_tokens": []
  },

  "tokens": [
    {
      "name": "example-hotp",
      "type": "hotp",
      "secret": "JBSWY3DPEHPK3PXP",
      "digits": 6,
      "algorithm": "sha1",
      "counter_start": 0
    }
  ]
}
